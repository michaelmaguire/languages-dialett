% PDF/X settings for the colour covers of the A5 books (*_a5_book_cover_<shop>.pdf), read by Ghostscript in
% step5_build_pdfs.py, which fills in {{icc}}: the PSO Coated v3 profile (FOGRA51), since cover card is coated
% (owner, 2026-10-31). The profile is embedded as the output intent. Based on Ghostscript's lib/PDFX_def.ps.
[ /GTS_PDFXVersion (PDF/X-3:2002)
  /Trapped /False
/DOCINFO pdfmark
[/_objdef {icc_PDFX} /type /stream /OBJ pdfmark
[{icc_PDFX} << /N 4 >> /PUT pdfmark
[{icc_PDFX} ({{icc}}) (r) file /PUT pdfmark
[/_objdef {OutputIntent_PDFX} /type /dict /OBJ pdfmark
[{OutputIntent_PDFX} <<
  /Type /OutputIntent
  /S /GTS_PDFX
  /OutputCondition (PSO Coated v3 \(FOGRA51\))
  /Info (PSO Coated v3 \(FOGRA51\))
  /OutputConditionIdentifier (FOGRA51)
  /RegistryName (http://www.color.org)
  /DestOutputProfile {icc_PDFX}
>> /PUT pdfmark
[{Catalog} <</OutputIntents [ {OutputIntent_PDFX} ]>> /PUT pdfmark
